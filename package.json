{
  "name": "opencode-bps-auth",
  "version": "0.5.1",
  "description": "Magpie provider for independent Excel/BPS OAuth and Responses inference",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./server": "./index.mjs"
  },
  "files": [
    "index.mjs",
    "src",
    "ui",
    "!ui/probe-results/**",
    "!ui/reset-results/**",
    "bin/bps-bridge-win32-x64.exe",
    "bin/bps-bridge-win32-arm64.exe",
    "bin/bps-bridge-linux-x64",
    "bin/bps-bridge-linux-arm64",
    "bin/bps-bridge-darwin-x64",
    "bin/bps-bridge-darwin-arm64",
    "bin/manifest.json",
    "bridge",
    "scripts",
    "tests",
    "licenses",
    "README.md",
    "VALIDATION.md",
    "AUDIT.md",
    "LICENSE",
    "NOTICE.md",
    "provenance.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs --all",
    "prepack": "node scripts/verify-binaries.mjs",
    "test": "node scripts/test.mjs",
    "test:js": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie",
    "provider",
    "bps",
    "oauth"
  ],
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pdxxxx/bps-magpie.git"
  },
  "homepage": "https://github.com/pdxxxx/bps-magpie#readme",
  "bugs": "https://github.com/pdxxxx/bps-magpie/issues",
  "magpie": {
    "name": "BPS",
    "maxConcurrency": 4,
    "page": {
      "title": "BPS settings",
      "titles": {
        "zh": "BPS 设置"
      },
      "file": "ui/index.html",
      "icon": "ui/icon.svg"
    },
    "summary": {
      "zh": "Excel/BPS 授权、统一代理、推理与压缩、额度与重置次数展示",
      "en": "Excel/BPS OAuth, proxy settings, inference, compaction and quota display"
    },
    "icon": "data:image/svg+xml;base64,"
  }
}
